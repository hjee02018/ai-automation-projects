<Window x:Class="EmulatorTrial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:EmulatorTrial.Views"
        xmlns:conv="clr-namespace:EmulatorTrial.Converters"
        mc:Ignorable="d"
        Title="SRM(Stacker Crane) Industrial Emulator - Advanced P2 Sim" Height="900" Width="1560"
        Background="#F3F4F6">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <conv:WidthConverter x:Key="WidthConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#1F2937" Padding="20,12" Grid.Row="0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M13,10H18L12,16L6,10H11V3H13V10M4,19H20V21H4V19Z" Fill="#3B82F6" Width="24" Height="24" Stretch="Uniform" Margin="0,0,12,0"/>
                    <TextBlock Text="SRM Digital Twin &amp; Physics Simulator" Foreground="White" FontSize="22" FontWeight="ExtraBold" />
                    <Border Background="#3B82F6" CornerRadius="4" Margin="15,0,0,0" Padding="8,2">
                        <TextBlock Text="P2 SIMULATOR ACTIVE" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#111827" Padding="15,7" CornerRadius="8" BorderBrush="#374151" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#EF4444"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                <Setter Property="Fill" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="TCP SERVER: " Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ServerStatusText}" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0" FontSize="13"/>
                            <Rectangle Width="1" Height="16" Fill="#374151" Margin="0,2"/>
                            <TextBlock Text="CONNECTED WCS: " Foreground="#9CA3AF" VerticalAlignment="Center" FontSize="12" Margin="20,0,8,0" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ClientCount}" Foreground="#3B82F6" FontWeight="Bold" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F9FAFB" CornerRadius="12,12,0,0" Padding="15" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                        <TextBlock Text="SRM Physical Simulation" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <views:EquipmentListView x:Name="EquipmentListControl" Margin="0,0,0,15"/>

                            <Separator Background="#F3F4F6" Margin="0,10"/>

                            <!--<views:SimulationConfigView x:Name="ConfigControl" Margin="0,0,0,15"/>-->

                            <Separator Background="#F3F4F6" Margin="0,10"/>

                            <TextBlock Text="REAL-TIME METRICS" FontSize="11" FontWeight="Bold" Foreground="#6B7280" Margin="2,0,0,8"/>
                            <Border Background="#F3F4F6" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Throughput (Efficiency)" FontSize="10" Foreground="#6B7280" FontWeight="SemiBold"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding TotalThroughput, FallbackValue=124}" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                                                <TextBlock Text=" cycles/hr" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#DBEAFE" Padding="6,2" CornerRadius="4">
                                            <TextBlock Text="OPTIMAL" FontSize="10" Foreground="#2563EB" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>

                                    <UniformGrid Columns="2">
                                        <StackPanel Margin="0,0,5,10">
                                            <TextBlock Text="POSITION X (BAY)" FontSize="10" Foreground="#9CA3AF"/>
                                            <TextBlock Text="{Binding CurrentBay, FallbackValue=18}" FontSize="14" FontWeight="Bold" Foreground="#374151"/>
                                        </StackPanel>
                                        <StackPanel Margin="5,0,0,10">
                                            <TextBlock Text="POSITION Z (LVL)" FontSize="10" Foreground="#9CA3AF"/>
                                            <TextBlock Text="{Binding CurrentLevel, FallbackValue=05}" FontSize="14" FontWeight="Bold" Foreground="#374151"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,5,0">
                                            <TextBlock Text="TRAVEL (M/S)" FontSize="10" Foreground="#9CA3AF"/>
                                            <TextBlock Text="{Binding TravelSpeed, FallbackValue=3.2}" FontSize="14" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                        <StackPanel Margin="5,0,0,0">
                                            <TextBlock Text="HOIST (M/S)" FontSize="10" Foreground="#9CA3AF"/>
                                            <TextBlock Text="{Binding HoistSpeed, FallbackValue=0.8}" FontSize="14" FontWeight="Bold" Foreground="#8B5CF6"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Separator Background="#F3F4F6" Margin="0,10"/>

                            <views:PerformMonitorView x:Name="HealthMonitorControl" Margin="0,10,0,10"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="15" Background="#F9FAFB" CornerRadius="0,0,12,12" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Button Content="START SIMULATION" 
                                    Background="#3B82F6" 
                                    Foreground="White" 
                                    Height="45"
                                    FontSize="14"
                                    FontWeight="Bold" 
                                    BorderThickness="0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="RESET SCENARIO" 
                                    Margin="0,8,0,0"
                                    Background="Transparent" 
                                    Foreground="#6B7280" 
                                    BorderBrush="#D1D5DB"
                                    BorderThickness="1"
                                    Height="35"
                                    FontSize="12"
                                    FontWeight="SemiBold">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#111827" CornerRadius="12" Margin="6" BorderBrush="#374151" BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Padding="15,10" Background="#1F2937">
                            <DockPanel>
                                <ToggleButton x:Name="BtnShowSplit" Background="Transparent" BorderThickness="1" BorderBrush="#3B82F6" Padding="8,2" Cursor="Hand">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton">
                                            <Setter Property="Content" Value="SPLIT VIEW (3D)"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Content" Value="SINGLE VIEW (PROT)"/>
                                                    <Setter Property="Background" Value="#3B82F6"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <TextBlock Text="MONITORING ENGINE" Foreground="#10B981" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                            </DockPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding IsChecked, ElementName=BtnShowSplit, Converter={StaticResource WidthConverter}}"/>
                            </Grid.ColumnDefinitions>

                            <views:CommunicationView x:Name="CommControl" Grid.Column="0" Margin="5"/>

                            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                                          Background="#374151" ShowsPreview="True"
                                          Visibility="{Binding IsChecked, ElementName=BtnShowSplit, Converter={StaticResource BoolToVis}}"/>

                            <Border Grid.Column="2" BorderBrush="#374151" BorderThickness="1,0,0,0" 
                                    Visibility="{Binding IsChecked, ElementName=BtnShowSplit, Converter={StaticResource BoolToVis}}">
                                <wv2:WebView2 x:Name="WebView3D" Margin="1" Source="about:blank"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="6" BorderBrush="#E5E7EB" BorderThickness="1">
                    <views:LogView x:Name="LogControl"/>
                </Border>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <views:SimulationConfigView Grid.Row="0" x:Name="ConfigControl" Margin="0,0,0,10"/>

                <Button Grid.Row="1" Content="SAVE CONFIGURATION" 
            Height="40" Margin="5"
            Background="#3B82F6" Foreground="White" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>