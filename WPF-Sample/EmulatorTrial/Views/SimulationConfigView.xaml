<UserControl x:Class="EmulatorTrial.Views.SimulationConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">

    <Border Background="White"
            CornerRadius="10"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            Padding="15">

        <StackPanel>

            <!-- Title -->
            <TextBlock Text="SIMULATION CONFIGURATION"
                       FontSize="13"
                       FontWeight="Bold"
                       Foreground="#111827"
                       Margin="0,0,0,12"/>

            <!-- Speed Settings -->
            <TextBlock Text="Speed Limits"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#6B7280"
                       Margin="0,0,0,6"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Max Travel Speed (m/s)"
                               FontSize="10"
                               Foreground="#6B7280"/>
                    <TextBox Text="{Binding Config.MaxTravelSpeed, Mode=TwoWay}"
                             Height="28"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="Max Hoist Speed (m/s)"
                               FontSize="10"
                               Foreground="#6B7280"/>
                    <TextBox Text="{Binding Config.MaxHoistSpeed, Mode=TwoWay}"
                             Height="28"/>
                </StackPanel>
            </Grid>

            <!-- Position Limits -->
            <TextBlock Text="Operation Range"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="#6B7280"
                       Margin="0,0,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Max Bay"
                               FontSize="10"
                               Foreground="#6B7280"/>
                    <TextBox Text="{Binding Config.MaxBay, Mode=TwoWay}"
                             Height="28"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="Max Level"
                               FontSize="10"
                               Foreground="#6B7280"/>
                    <TextBox Text="{Binding Config.MaxLevel, Mode=TwoWay}"
                             Height="28"/>
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>
