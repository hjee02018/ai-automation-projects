<UserControl x:Class="EmulatorTrial.Views.EquipmentListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="300">
    <Border Background="Transparent">
        <StackPanel>
            <!-- 헤더 영역 -->
            <TextBlock Text="설비 목록 및 통신 상태 (SRM)"
                       FontSize="14"
                       FontWeight="Bold"
                       Foreground="#374151"
                       Margin="0,0,0,12"/>

            <!-- 설비 목록 리스트박스 -->
            <ListBox ItemsSource="{Binding Equipments}"
                     Background="Transparent"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" 
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="4">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" 
                                BorderBrush="#E5E7EB" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="12"
                                Margin="0,2">
                            <StackPanel>
                                <!-- 상단: 아이디 및 연결 표시기 -->
                                <DockPanel LastChildFill="True">
                                    <Ellipse DockPanel.Dock="Left" 
                                             Width="10" Height="10" 
                                             VerticalAlignment="Center" 
                                             Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#EF4444"/>
                                                <!-- Offline -->
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                        <Setter Property="Fill" Value="#10B981"/>
                                                        <!-- Online -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <!-- 작업 상태 태그 -->
                                    <Border DockPanel.Dock="Right" Padding="6,2" CornerRadius="10" Background="#F3F4F6">
                                        <TextBlock Text="{Binding Status}" Foreground="#4B5563" FontSize="10" FontWeight="Bold"/>
                                    </Border>

                                    <TextBlock Text="{Binding Id}" FontWeight="Bold" Foreground="#111827" FontSize="13"/>
                                </DockPanel>

                                <TextBlock Text="{Binding Name}" Foreground="#6B7280" FontSize="11" Margin="20,2,0,8"/>

                                <!-- 통신 상세 정보 (포트, 클라이언트) -->
                                <Border Background="#F9FAFB" CornerRadius="4" Padding="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="통신 포트" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold"/>
                                            <TextBlock Text="TCP/18888" FontSize="11" Foreground="#3B82F6" FontWeight="SemiBold"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="접속 대수" FontSize="9" Foreground="#9CA3AF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <!-- 메인 뷰모델의 ClientCount를 참조하거나 개별 할당 필요 -->
                                                <TextBlock Text="{Binding DataContext.ClientCount, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                           FontSize="11" Foreground="#111827" FontWeight="Bold"/>
                                                <TextBlock Text=" Connected" FontSize="11" Foreground="#6B7280"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Border>
</UserControl>