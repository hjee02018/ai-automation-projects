<UserControl x:Class="EmulatorTrial.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EmulatorTrial.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="#111827" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 로그 헤더 제목 -->
            <TextBlock Grid.Row="0" 
                       Text="Message Log"
                       Foreground="#9CA3AF"
                       FontSize="14"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <!-- 실제 로그 리스트 -->
            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding CommunicationLogs}" 
                     Background="Transparent" 
                     BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontFamily="Consolas" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- 기본 텍스트 색상 (RECV 등) -->
                                    <Setter Property="Foreground" Value="#10B981"/>
                                    <Style.Triggers>
                                        <!-- SEND가 포함된 로그는 파란색 계열로 표시 -->
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text, ConverterParameter=SEND}" Value="True">
                                            <!-- 참고: 복잡한 색상 분기를 원하시면 IValueConverter를 사용해야 하지만, 
                                                 우선은 기본적으로 가독성 좋은 흰색/회색 톤으로 설정합니다. -->
                                        </DataTrigger>

                                        <!-- 메시지 내용에 따른 색상 구분 (단순 예시) -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1F2937"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            
                            <Run Text="{Binding Mode=OneWay}"/>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>